+            if event.get("response"):
+                yield {"type": "text", "text": str(event["response"])}
+            for tc in (event.get("tool_calls") or []):
+                if not isinstance(tc, dict):
+                    continue
+                idx = tc.get("index")
+                idx = int(idx) if isinstance(idx, (int, float)) else 0
+                fc = tc.get("function_call")
+                if not isinstance(fc, dict):
+                    fc = tc.get("function") if isinstance(tc.get("function"), dict) else {}
+                yield {"type": "tool_call", "index": idx,
+                       "id": str(tc.get("id") or ""),
+                       "name": str(fc.get("name") or ""),
+                       "arguments": str(fc.get("arguments") or "")}
+            if event.get("finish_reason"):
+                finish_reason = str(event["finish_reason"])
+            # token_usage 帧：DSH 算 token 的唯一来源，必须原样透传所有字段
+            if "prompt_tokens" in event:
+                usage = {k: event.get(k) for k in USAGE_FIELDS if k in event}
+                usage["prompt_tokens"] = int(event.get("prompt_tokens") or 0)
+                usage["completion_tokens"] = int(event.get("completion_tokens") or 0)
+                usage["total_tokens"] = int(event.get("total_tokens") or 0)
+    finally:
+        try:
+            resp.close()
+        except Exception:
+            pass
+    yield {"type": "done", "finish_reason": finish_reason, "usage": usage}
