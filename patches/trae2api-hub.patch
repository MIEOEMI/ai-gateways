+def _client_label(ua):
+    """User-Agent -> 可读客户端名（面板按此分组）。只做标识，不参与鉴权。"""
+    u = (ua or "").strip()
+    if not u:
+        return "(无 UA)"
+    low = u.lower()
+    for needle, label in (
+        ("deepseek-harness", "DSH"),
+        ("dsh", "DSH"),
+        ("claude-cli", "Claude Code"),
+        ("claude-code", "Claude Code"),
+        ("codex", "Codex CLI"),
+        ("hermes", "Hermes"),
+        ("openai-python", "Python SDK"),
+        ("openai-node", "Node SDK"),
+        ("httpx", "Python httpx"),
+        ("python-requests", "Python requests"),
+        ("aiohttp", "Python aiohttp"),
+        ("node-fetch", "Node fetch"),
+        ("undici", "Node undici"),
+        ("curl", "curl"),
+        ("postman", "Postman"),
+        ("insomnia", "Insomnia"),
+        ("cherry", "Cherry Studio"),
+        ("lobechat", "LobeChat"),
+        ("chatbox", "Chatbox"),
+        ("nextchat", "NextChat"),
+    ):
+        if needle in low:
+            return label
+    head = u.split()[0].split("/")[0]
+    return head[:40] or "(未知)"
+
