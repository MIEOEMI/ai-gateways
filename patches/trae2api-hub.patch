+def trae_solo_chat_stream(account, payload, timeout=180):
+    """流式版 SOLO 对话：**边读上游边产出**，逐帧交给调用方。
+
+    与 `trae_solo_chat` 的区别（这是"假流式"的根因修复）：后者把整个 SSE 读完
+    才 return，调用方只能一次性把全文塞进一个 chunk —— 客户端看到的是"卡很久
+    然后整段蹦出来"。本函数每收到一个 output 帧就 yield 一次，配合调用方的
+    `_sse_write` 才是真流式。
+
+    yield 的 dict 形状：
+      {"type": "text",      "text": str}         正文增量
+      {"type": "reasoning", "text": str}         思考增量
+      {"type": "tool_call", "index": int, "id": str,
+                            "name": str, "arguments": str}   工具调用增量
+      {"type": "done", "finish_reason": str, "usage": dict}    收尾（一定最后一条）
+
+    usage 取自上游的 `token_usage` 事件帧（包含 prompt/completion/total 以及
+    reasoning_tokens、缓存命中字段），这是 DSH 能算 token 的关键数据源。
+    """
+    token = str(getattr(account, "token", "") or "").strip()
+    if not token:
+        raise RuntimeError("account access token is empty")
+    uid = str(getattr(account, "uid", "") or "").strip()
+    extra = getattr(account, "extra", None) or {}
+    dev = str(extra.get("device_id") or os.environ.get("TRAE_DEVICE_ID") or "1149420231460112").strip()
+    mid = str(extra.get("machine_id") or os.environ.get("TRAE_MACHINE_ID") or "d979d81c1deda7a803cb6b76be69cff63b40dd24ea60d3fabbd865607f7ee695").strip()
+    headers = {
+        "Accept": "text/event-stream",
+        "Content-Type": "application/json",
+        "User-Agent": "Trae/0.1.61 antigravity-cockpit-tools",
+        "Authorization": "Cloud-IDE-JWT " + token,
+        "X-Cloudide-Token": token,
+        "X-Ide-Token": token,
+        "X-Uid": uid,
+        "X-Machine-Id": mid,
+        "X-Device-Id": dev,
+        "X-App-Id": "6eefa01c-1036-4c7e-9ca5-d891f63bfcd8",
+        "X-App-Version": "default",
+        "X-Ide-Version": "0.1.61",
+        "X-Ide-Version-Code": "20260820",
+        "X-App-Version-Code": "20260820",
+        "X-Ide-Version-Type": "stable",
+        "X-Device-Type": "windows",
+        "X-OS-Version": "Windows 11 Pro",
+        "X-Device-Brand": "83DG",
+        "Request-Traffic-Type": "prod",
+    }
+    model = str(payload.get("model") or "deepseek-v4.1-flash").strip()
+    model = SOLO_MODEL_ALIASES.get(model, model)
+    if model.endswith("-solo"):
+        model = model[:-5]
+    messages = []
+    for m in payload.get("messages") or []:
+        if not isinstance(m, dict):
+            continue
+        role = str(m.get("role") or "user")
+        if role == "developer":
+            role = "system"
+        content = m.get("content")
+        if isinstance(content, str):
+            blocks = [{"type": "text", "text": content}]
+        elif isinstance(content, list):
+            blocks = []
+            for part in content:
+                if isinstance(part, dict) and part.get("type") == "text":
+                    blocks.append({"type": "text", "text": str(part.get("text") or "")})
+            if not blocks:
+                continue
